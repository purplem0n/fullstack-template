{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: all (api + web + mobile)",
      "type": "shell",
      "command": "bun run dev",
      "isBackground": true,
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "dev: web only",
      "type": "shell",
      "command": "bun run --cwd apps/web dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^x^"
        },
        "background": {
          "activesBegin": ".",
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "dev: mobile only",
      "type": "shell",
      "command": "bun run --cwd apps/mobile dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev: api + web",
      "type": "shell",
      "command": "bun run dev:web",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev: api + mobile",
      "type": "shell",
      "command": "bun run dev:mobile",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "prod api: mobile",
      "type": "shell",
      "command": "bun run dev:mobile:prod-api",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "prod: preview web build",
      "type": "shell",
      "command": "bun run preview:web",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "deploy",
      "type": "shell",
      "command": "bun run deploy",
      "problemMatcher": []
    },
    {
      "label": "check: lint + typecheck + test + build",
      "type": "shell",
      "command": "bun run check:all",
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "db: migrate local",
      "type": "shell",
      "command": "bun run db:migrate",
      "problemMatcher": []
    },
    {
      "label": "tokens: regenerate",
      "type": "shell",
      "command": "bun run tokens",
      "problemMatcher": []
    },
    {
      "label": "watch: types apps/api",
      "type": "shell",
      "command": "bunx tsc --noEmit --watch --preserveWatchOutput",
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$tsc-watch",
        "fileLocation": ["relative", "${workspaceFolder}/apps/api"]
      },
      "presentation": {
        "reveal": "never",
        "group": "watch"
      }
    },
    {
      "label": "watch: types apps/web",
      "type": "shell",
      "command": "bunx react-router typegen && (bunx react-router typegen --watch >/dev/null & bunx tsc --noEmit --watch --preserveWatchOutput)",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$tsc-watch",
        "fileLocation": ["relative", "${workspaceFolder}/apps/web"]
      },
      "presentation": {
        "reveal": "never",
        "group": "watch"
      }
    },
    {
      "label": "watch: types apps/mobile",
      "type": "shell",
      "command": "bunx tsc --noEmit --watch --preserveWatchOutput",
      "options": {
        "cwd": "${workspaceFolder}/apps/mobile"
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$tsc-watch",
        "fileLocation": ["relative", "${workspaceFolder}/apps/mobile"]
      },
      "presentation": {
        "reveal": "never",
        "group": "watch"
      }
    },
    {
      "label": "watch: types packages/shared",
      "type": "shell",
      "command": "bunx tsc --noEmit --watch --preserveWatchOutput",
      "options": {
        "cwd": "${workspaceFolder}/packages/shared"
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$tsc-watch",
        "fileLocation": ["relative", "${workspaceFolder}/packages/shared"]
      },
      "presentation": {
        "reveal": "never",
        "group": "watch"
      }
    },
    {
      "label": "watch: types packages/api-client",
      "type": "shell",
      "command": "bunx tsc --noEmit --watch --preserveWatchOutput",
      "options": {
        "cwd": "${workspaceFolder}/packages/api-client"
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$tsc-watch",
        "fileLocation": ["relative", "${workspaceFolder}/packages/api-client"]
      },
      "presentation": {
        "reveal": "never",
        "group": "watch"
      }
    },
    {
      "label": "watch: types packages/tokens",
      "type": "shell",
      "command": "bunx tsc --noEmit --watch --preserveWatchOutput",
      "options": {
        "cwd": "${workspaceFolder}/packages/tokens"
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$tsc-watch",
        "fileLocation": ["relative", "${workspaceFolder}/packages/tokens"]
      },
      "presentation": {
        "reveal": "never",
        "group": "watch"
      }
    },
    {
      "label": "watch: typecheck all",
      "dependsOn": [
        "watch: types apps/api",
        "watch: types apps/web",
        "watch: types apps/mobile",
        "watch: types packages/shared",
        "watch: types packages/api-client",
        "watch: types packages/tokens",
        "watch: types apps/landing"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "dev: landing",
      "type": "shell",
      "command": "bun run dev:landing",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "prod: preview landing",
      "type": "shell",
      "command": "bun run preview:landing",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "deploy: landing",
      "type": "shell",
      "command": "bun run deploy:landing",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "watch: types apps/landing",
      "type": "shell",
      "command": "bunx astro check --watch",
      "options": {
        "cwd": "${workspaceFolder}/apps/landing"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "astro",
        "source": "astro",
        "fileLocation": ["relative", "${workspaceFolder}/apps/landing"],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+) - (error|warning) .*?: (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activatesForAllFiles": true,
          "beginsPattern": "Checking",
          "endsPattern": "Result"
        }
      },
      "presentation": {
        "reveal": "never",
        "group": "watch"
      }
    }
  ]
}
