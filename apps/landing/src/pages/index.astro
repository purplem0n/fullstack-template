---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center gap-6 p-6 text-center">
    <h1 class="text-5xl font-bold tracking-tight">Fullstack Template</h1>
    <p class="text-lg text-muted-foreground">
      Replace this placeholder with your landing page. Design direction comes from the design skills in
      <code>.agents/skills</code>.
    </p>
    <a
      href="https://fullstack-template.YOUR-SUBDOMAIN.workers.dev"
      class="rounded-lg bg-primary px-6 py-3 font-medium text-primary-foreground"
    >
      Open the app
    </a>
  </main>
</Layout>
