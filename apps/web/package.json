{
  "name": "@repo/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "[ -f .dev.vars ] || cp .dev.vars.example .dev.vars; wrangler d1 migrations apply DB --local && react-router dev",
    "build": "react-router build",
    "preview": "react-router build && vite preview",
    "deploy": "react-router build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types && react-router typegen",
    "typecheck": "wrangler types >/dev/null && react-router typegen && bun check",
    "typegen": "react-router typegen"
  },
  "dependencies": {
    "@repo/api-client": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/tokens": "workspace:*",
    "@tanstack/react-query": "^5.90.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.2.2",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "@repo/api": "workspace:*",
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "wrangler": "^4.157.0"
  }
}
