{
  "name": "fullstack-template",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=!@repo/landing",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:mobile": "turbo run dev --filter=@repo/web --filter=@repo/mobile",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "bun run --cwd apps/web db:migrate:local",
    "tokens": "bun run --cwd packages/tokens build",
    "dev:mobile:prod-api": "bun run --cwd apps/mobile dev:prod-api",
    "preview:web": "bun run --cwd apps/web preview",
    "fix": "bun fmt && bun lint --fix",
    "check:all": "bun lint --max-warnings=0 && bun fmt --check && bun run typecheck && bun run test && bun run build",
    "deploy": "bun run --cwd apps/web deploy",
    "postinstall": "bun run --cwd apps/web typegen",
    "dev:landing": "bun run --cwd apps/landing dev",
    "preview:landing": "bun run --cwd apps/landing preview",
    "deploy:landing": "bun run --cwd apps/landing deploy"
  },
  "devDependencies": {
    "turbo": "^2.6.0",
    "typescript": "~6.0.3"
  }
}
